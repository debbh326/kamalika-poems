---
layout: null
permalink: /search.json
---
{%- include writings.html -%}
[
{%- for sx_doc in writings %}
{%- include doc-info.html doc=sx_doc -%}
{%- if sx_doc.poem %}{% assign sx_text = sx_doc.poem %}{% elsif sx_doc.story %}{% assign sx_text = sx_doc.story %}{% else %}{% assign sx_text = sx_doc.content | strip_html %}{% endif %}
  {
    "title": {{ doc_heading | jsonify }},
    "title_en": {{ doc_heading_en | default: "" | jsonify }},
    "part": {{ doc_part | default: "" | jsonify }},
    "kind": {{ doc_kind.en | jsonify }},
    "lang": {{ doc_lang | jsonify }},
    "lang_name": {{ doc_language.name | jsonify }},
    "date": {{ sx_doc.date | date: "%b %-d, %Y" | jsonify }},
    "url": {{ sx_doc.url | relative_url | jsonify }},
    "text": {{ sx_text | normalize_whitespace | strip | truncatewords: 400, "" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
